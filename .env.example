# Contact & newsletter forms are mock-only in this build (no data leaves the browser).
# Wire up a real provider later and read these via process.env — never hardcode keys in code.
EMAIL_PROVIDER_API_KEY=
CONTACT_RECIPIENT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Order confirmation email (src/app/api/order/route.ts) ---------------
# Fill these in with a real mailbox to make checkout actually send an order
# confirmation email. Until SMTP_HOST/SMTP_USER/SMTP_PASS are all set, the
# order still "succeeds" in the UI, it just skips sending mail.
#
# Gmail: smtp.gmail.com, port 587. You MUST use an App Password, not your
#   normal password — https://myaccount.google.com/apppasswords (requires
#   2-Step Verification to be enabled first).
# Outlook/Office365: smtp.office365.com, port 587.
# Any other provider: use the SMTP host/port they give you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset. Can be "Display Name <email>".
SMTP_FROM=
# Optional — a store-owner mailbox that gets a copy of every order.
STORE_ORDER_EMAIL=
